#!/usr/bin/env bash

# Stand in for wget in the test image: crucible modules are served from the
# working tree in /srv/src instead of GitHub, so tests see unpushed changes.
out="" url=""
while [ $# -gt 0 ]; do
  case "$1" in
  -O)
    out="$2"
    shift 2
    ;;
  -q | --no-cache) shift ;;
  *)
    url="$1"
    shift
    ;;
  esac
done
src="/srv/src/bash/${url#*/src/bash/}"
[ -f "$src" ] || {
  echo "wget stand in: no such module $src" >&2
  exit 8
}
cp "$src" "$out"
