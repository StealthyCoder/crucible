FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install --no-install-recommends -y wget ca-certificates file binutils xxd netcat-openbsd libdigest-sha-perl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Shadows the real wget, see the file for why
COPY wget /usr/local/bin/wget
COPY test.sh /usr/local/bin/crucible-test

ENTRYPOINT ["/usr/local/bin/crucible-test"]
